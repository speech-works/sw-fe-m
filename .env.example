API_BASE_URL=
ALLOW_SIMULATOR_HEADSET_BYPASS=false
# Ask the first five onboarding questions BEFORE an account exists, so the
# signup step unlocks a plan instead of guarding one. Defaults to true even if
# this line is removed; set to "false" to fall back to the login-first flow.
PRE_AUTH_ONBOARDING_ENABLED=true
# Master switch for the whole purchase flow (paywall, wallet chip, Programs
# entry, restore row). Keep false until the store products + RevenueCat keys
# below are real — with it on and no keys, purchasesAvailable() is false
# anyway, but the UI would advertise buttons that cannot complete a sale.
PAYMENTS_ENABLED=false
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
SENTRY_AUTH_TOKEN=
# Optional — falls back to the real Speechworks DSN baked into App.tsx if
# unset. Only set this to point crash reports at a different Sentry project.
EXPO_PUBLIC_SENTRY_DSN=